# ============================================================
# .env.template — copy to .env and fill in your values
# Run: source .env
# Never commit .env to git
# ============================================================

# ── Kaggle credentials ────────────────────────────────────────────────────────
# Get yours at: https://www.kaggle.com/settings/account
export KAGGLE_USERNAME="your_kaggle_username"
export KAGGLE_API_KEY="your_kaggle_api_key"

# ── Data location ─────────────────────────────────────────────────────────────
# Where to store raw DICOM files and processed .npy files.
# Default is ./data inside the repo — override if you want
# data on a separate disk or shared storage.
export DATA_ROOT=""

# ── Federated learning parameters ────────────────────────────────────────────
# Defaults are set in config.py — only set these to override.
export N_CLIENTS="3"
export N_ROUNDS="10"
export LOCAL_EPOCHS="3"
export BATCH_SIZE="32"
export LR="0.001"
export IMG_SIZE="224"
export GS_ITER_COUNT="50"
